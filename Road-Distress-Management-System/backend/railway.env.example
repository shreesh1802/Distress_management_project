# =====================================================================
#  RAILWAY SETTINGS  -  for the hosted server
# =====================================================================
#
#  HOW TO USE
#    1. In Railway open your backend service  >  Variables
#    2. Add each setting below as a variable
#       (name on the left of "=", value on the right)
#    3. Replace every value marked  CHANGE THE VALUE
#    4. Railway restarts the server by itself
#
#  IMPORTANT
#    - THIS FILE IS A TEMPLATE. Never type real passwords or keys into it:
#      it is committed to git. Put real values ONLY in Railway.
#      (If you want a private copy of your real values, use a file named
#      .env.railway - git ignores that one.)
#    - For running on your own computer use  local.env.example  instead.
#
# =====================================================================


# ---------------------------------------------------------------------
#  1. BASIC SETTINGS                                          REQUIRED
# ---------------------------------------------------------------------
#  Tells the server it is running for real (safe mode).      Keep as is.
APP_ENV=production

#  The port the server listens on.                           Keep as is.
PORT=8000

#  Railway puts one gateway in front of the server.          Keep as is.
TRUSTED_PROXY_COUNT=1

#  The database. Keep this exact text. It connects the server to the
#  Postgres database you added in Railway.
#  (If your database service has a different name than "Postgres",
#   use that name instead.)
DATABASE_URL=${{Postgres.DATABASE_URL}}


# ---------------------------------------------------------------------
#  2. GOOGLE SIGN-IN                                          REQUIRED
# ---------------------------------------------------------------------
#  The Firebase key that lets the server check who is logging in.
#  Without it the server will refuse to start.
#
#  WHAT TO PUT HERE:  the WHOLE contents of the key file,
#                     from the first  {  to the last  }
#
#  HOW TO GET THE FILE:
#     Firebase console > Project settings > Service accounts >
#     "Generate new private key"  (it downloads a .json file)
#
#  This is like a password. Treat it as secret.
#  >>> CHANGE THE VALUE ON THE NEXT LINE <<<
FIREBASE_CREDENTIALS_JSON=<paste the whole key file contents here>


# ---------------------------------------------------------------------
#  3. SECURITY                                                REQUIRED
# ---------------------------------------------------------------------
#  A long random text used to protect report download links.
#  Make one by running this on your computer:
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#  It must be at least 32 characters.
#  >>> CHANGE THE VALUE ON THE NEXT LINE <<<
DOWNLOAD_SIGNING_SECRET=<paste the random text here>

#  Which website may talk to the server.
#  Write the website address exactly. No "/" at the end, no "*".
#  If you only have the Android app, you can leave this out.
BACKEND_CORS_ORIGINS=https://road-inspection-web.pages.dev


# ---------------------------------------------------------------------
#  4. AI MODEL FILES                                          REQUIRED
# ---------------------------------------------------------------------
#  The server downloads the two AI model files from here when it starts.
#
#  MODEL_BASE_URL       = the web address of the folder that holds
#                         road_best.pth and signage_best.pth
#  MODEL_DOWNLOAD_TOKEN = a read-only access key for that folder.
#                         Delete this line if the folder is public.
#  >>> CHANGE THE VALUE ON THE NEXT LINE <<<
MODEL_BASE_URL=https://huggingface.co/YOUR-USERNAME/YOUR-REPO/resolve/main
#  >>> CHANGE THE VALUE ON THE NEXT LINE <<<
MODEL_DOWNLOAD_TOKEN=YOUR-READ-ONLY-KEY
