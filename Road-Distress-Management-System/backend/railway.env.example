# Variables for the Railway backend service (Variables -> Raw Editor: paste, then replace every <...>).
# This file contains NO secrets. Never paste real values into git, chat or screenshots.

# --- core -------------------------------------------------------------------
APP_ENV=production
PORT=8000
TRUSTED_PROXY_COUNT=1
# Railway reference to the Postgres plugin (keep the ${{ }} exactly; "Postgres" = the database service's name)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Google sign-in (Firebase) ---------------------------------------------------------
# Firebase console -> Project settings -> Service accounts -> Generate new private key. Paste the WHOLE JSON file
# as the value (Railway keeps it as a secret). Without it the server refuses to start. Who may sign in is the
# Firestore collection "allowedUsers" (document ID = Google e-mail, field role = admin | inspector | maintenance).
FIREBASE_CREDENTIALS_JSON=<paste the service-account JSON here>

# --- security ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DOWNLOAD_SIGNING_SECRET=<random 48+ characters>
# Exact website origin(s), comma separated, no trailing slash. Leave out entirely for an Android-only app.
BACKEND_CORS_ORIGINS=https://road-inspection-web.pages.dev

# --- AI model weights (road_best.pth, signage_best.pth) ----------------------------------
# Folder URL that serves the two files; the server downloads them at start-up if the build did not include them.
# Hugging Face example: https://huggingface.co/<user>/<repo>/resolve/main
MODEL_BASE_URL=<https url of the folder holding the two .pth files>
# Only for a private repository: a read-only access token.
MODEL_DOWNLOAD_TOKEN=<read token, or delete this line>
