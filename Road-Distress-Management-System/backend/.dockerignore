.venv
venv
__pycache__
**/__pycache__
*.pyc
uploads/
reports/
# models/ is NOT ignored: if the build checkout contains the real weights they ship in the image;
# otherwise app.services.ai.model_provisioning downloads them at start-up (MODEL_BASE_URL).
.pytest_cache
.git
*.log

# --- never bake secrets, local databases, binaries or caches into an image ---
.env
.env.*
*.db
*.sqlite
*.sqlite3
*.exe
scripts/*.exe
.cache/
*.apk
*.mp4
*.jks
*.keystore
key.properties
google-services.json

# --- tests and test data are not needed at runtime ---
tests/
test_*.py
