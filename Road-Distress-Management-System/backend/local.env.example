# =====================================================================
#  LOCAL SETTINGS FILE  -  for running the backend on your own computer
# =====================================================================
#
#  HOW TO USE
#    1. Copy this file and name the copy  .env   (same folder: backend)
#    2. Change the values marked  <<< CHANGE ME
#    3. Save. Start the backend as usual.
#
#  IMPORTANT
#    - The real  .env  file is private. Git ignores it. Never share it.
#    - This example file has NO real secrets. It is safe to share.
#    - For the hosted server (Railway) use  railway.env.example  instead.
#
# =====================================================================


# ---------------------------------------------------------------------
#  1. DATABASE                                                REQUIRED
# ---------------------------------------------------------------------
#  Where the app stores its data.
#  Leave this as it is to use a simple file on your computer.
DATABASE_URL=sqlite:///./road_distress.db


# ---------------------------------------------------------------------
#  2. WEBSITE ACCESS                                          REQUIRED
# ---------------------------------------------------------------------
#  Lets the website on your computer talk to the backend.
#  Leave as it is. (Only for your own computer. Never use "*" on Railway.)
BACKEND_CORS_ORIGINS=*


# ---------------------------------------------------------------------
#  3. GOOGLE SIGN-IN                                          REQUIRED
# ---------------------------------------------------------------------
#  The app only signs in with Google, so the backend needs the Firebase
#  key file to check who is logging in.
#
#  WHAT TO PUT HERE:  the path to the key file on your computer
#                     (not the contents of the file).
#
#  HOW TO GET THE FILE:
#     Firebase console > Project settings > Service accounts >
#     "Generate new private key"  (it downloads a .json file)
#
#  WHERE TO KEEP IT:
#     Save it in a private folder such as  C:\keys\
#     Do NOT keep it inside the project folder, and do NOT keep it in
#     OneDrive or Desktop (they sync to the cloud).
#
#  Use forward slashes  /  in the path.
#  >>> CHANGE THE VALUE ON THE NEXT LINE <<<
FIREBASE_CREDENTIALS_PATH=C:/keys/road-distress-firebase-adminsdk.json


# ---------------------------------------------------------------------
#  4. AI MODEL FILES                                          OPTIONAL
# ---------------------------------------------------------------------
#  Only needed if the two model files are missing on your computer:
#      backend/models/road_best.pth
#      backend/models/signage_best.pth
#  If the files are already there, leave these two lines commented out
#  (a line starting with  #  is ignored).
#
#  To use them: remove the  #  at the start of both lines and fill in.
#
#  MODEL_BASE_URL     = the web address of the folder that holds the files
#  MODEL_DOWNLOAD_TOKEN = a read-only access key, if that folder is private
#
# MODEL_BASE_URL=https://huggingface.co/YOUR-USERNAME/YOUR-REPO/resolve/main
# MODEL_DOWNLOAD_TOKEN=YOUR-READ-ONLY-KEY
