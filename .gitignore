# Environment files (server secrets, DB URLs, API keys) -- share privately
.env
.env.*
!.env.example

# Firebase Admin service-account keys -- share privately, never commit
**/secrets/
*firebase-adminsdk*.json
*service-account*.json

# Android signing keys
*.jks
*.keystore
key.properties

# Firebase app config (contains API keys -- share via secure channel, not git)
google-services.json
GoogleService-Info.plist

# Firebase CLI debug output (can contain request details)
firebase-debug.log
firestore-debug.log
