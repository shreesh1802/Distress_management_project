# Copy to key.properties (git-ignored) and fill in. NEVER commit key.properties or the .jks file.
storePassword=<password you chose for the keystore>
keyPassword=<password you chose for the key (may be the same)>
keyAlias=upload
# Absolute path, or relative to mobile/android/app/
storeFile=C:/Users/<you>/keys/road-inspection-upload.jks
